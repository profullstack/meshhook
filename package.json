{
  "name": "@profullstack/meshhook",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "apps/*",
    "workers",
    "packages/*"
  ],
  "trustedDependencies": [
    "esbuild"
  ],
  "scripts": {
    "mh": "bun packages/cli/bin/mh.js",
    "postinstall": "bun scripts/socket-patch.mjs",
    "format": "prettier -w .",
    "setup": "bun scripts/setup.js",
    "dev": "cd apps/web && bun --bun run dev",
    "build": "cd apps/web && bun --bun run build",
    "db:migrate": "bun scripts/db-migrate.js",
    "db:verify": "bun scripts/verify-migration.js",
    "issue:progress": "bun scripts/gh-project-status.js",
    "issue:done": "bun scripts/gh-project-status.js",
    "start": "bun workers/orchestrator.mjs",
    "db:status": "bun scripts/db-migrate.js --status",
    "test": "bun run test:vitest && bun run test:node",
    "test:watch": "bun --bun vitest",
    "test:node": "bun test src/nodes src/workers src/utils",
    "test:vitest": "bun --bun vitest run",
    "security:patch": "SOCKET_API_TOKEN=${SOCKET_API_TOKEN} bun scripts/socket-patch.mjs"
  },
  "devDependencies": {
    "chai": "^6.3.0",
    "dotenv": "^18.0.9",
    "inquirer": "^14.2.4",
    "prettier": "^3.9.10",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@meshhook/shared": "workspace:*",
    "@profullstack/x402-client": "0.3.0",
    "fast-xml-parser": "^5.11.2",
    "jmespath": "^0.16.0",
    "openai": "^7.43.0"
  },
  "overrides": {
    "source-map-js": "^1.2.2"
  }
}
