# MeshHook environment template
# Copy to .env and fill in real values. NEVER commit .env.

# ---------------------------------------------------------------------------
# Database (Postgres)
# ---------------------------------------------------------------------------
# The only database MeshHook accepts. Anything but postgres:// fails at start
# with the reason; there is no file-database fallback.
# The password belongs in the vault, not here; this placeholder has none.
DATABASE_URL=postgres://meshhook@localhost:5432/meshhook
#
# The Turso settings are retired. A set TURSO_DATABASE_URL is named in the
# error so a deploy that still carries it can be repointed:
#   npx libsql-pg copy --from "$TURSO_DATABASE_URL" --token "$TURSO_AUTH_TOKEN" --to "$DATABASE_URL" --verify

# ---------------------------------------------------------------------------
# Secrets vault
# ---------------------------------------------------------------------------
# Encrypts the secrets table with AES-256-GCM. Generate with:
#   openssl rand -hex 32
# Losing this key makes every stored secret unrecoverable; rotating it requires
# re-encrypting existing rows.
# LEGACY: no longer used to store secrets (values are sealed to each user's key vault).
SECRETS_ENCRYPTION_KEY=
# Operator x402 payer key: seal it with `bun scripts/operator-vault.mjs init && seal-x402`,
# then remove it from env. Until sealed, a plaintext X402_PRIVATE_KEY is still honoured
# (with an [alert] warning) unless LEGACY_KEY_MIGRATION=off.
LEGACY_KEY_MIGRATION=on

# ---------------------------------------------------------------------------
# Integrations
# ---------------------------------------------------------------------------
OPENAI_API_KEY=your-openai-api-key

# ---------------------------------------------------------------------------
# c0mpute (docs/c0mpute.md)
# ---------------------------------------------------------------------------
# Where steps run by default: auto (c0mpute when the token is set), local, c0mpute.
MESHHOOK_EXECUTOR=auto
# The local `c0mpute jobs serve` bridge. Token goes in the vault.
C0MPUTE_JOBS_URL=http://127.0.0.1:8788
C0MPUTE_JOBS_TOKEN=
# Optional cap per step, in the network's price unit.
C0MPUTE_MAX_PRICE=
# AI nodes: Infernet open market (c0mpute inference), peer nodes only.
INFERNET_URL=https://infernetprotocol.com
INFERNET_CLIENT_KEY=
MESHHOOK_AI_MODELS=qwen2.5:1.5b,qwen2.5:0.5b

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NODE_ENV=production
PORT=8080
